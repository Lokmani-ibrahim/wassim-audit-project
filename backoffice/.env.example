# Local isolated Keycloak and backend only. Copy to .env.local; never put a secret here.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=neos
VITE_KEYCLOAK_CLIENT_ID=neos-backoffice
VITE_API_BASE_URL=/api
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_POST_LOGOUT_URI=http://localhost:5173/
VITE_ENVIRONMENT_LABEL=Local isolated realm
