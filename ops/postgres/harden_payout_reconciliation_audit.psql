
\set ON_ERROR_STOP on

-- ============================================================
-- NEOS — Payout Reconciliation Audit Hardening
-- ============================================================
--
-- PURPOSE:
-- Protect payout_reconciliation_audit from modification
-- by the application runtime database role.
--
-- Runtime permissions:
--   SELECT   ALLOWED
--   INSERT   ALLOWED
--   UPDATE   DENIED
--   DELETE   DENIED
--   TRUNCATE DENIED
--
-- REQUIREMENTS:
-- 1. Execute as the migration/table-owner role.
-- 2. Runtime and migration roles must be distinct.
-- 3. Runtime must not belong to the table-owner role.
-- 4. Execute only against the intended production database.
-- 5. Do not execute automatically through Flyway.
--
-- EXAMPLE:
-- psql -v runtime_role=fintech_runtime \
--      -f ops/postgres/harden_payout_reconciliation_audit.psql
--
-- ============================================================

\if :{?runtime_role}
\else
    \echo 'Missing -v runtime_role=<application_role>'
    \quit 1
\endif

BEGIN;

-- Store validated input for use inside PL/pgSQL.
SELECT set_config(
    'neos.audit.runtime_role',
    :'runtime_role',
    true
);

-- ============================================================
-- 1. PRECONDITIONS
-- ============================================================

DO $$
DECLARE
    runtime_role TEXT :=
        current_setting('neos.audit.runtime_role');

    table_owner TEXT;
BEGIN

    -- Never harden the development test database.
    IF current_database() = 'fintech_dev' THEN
        RAISE EXCEPTION
            'Refusing to harden fintech_dev database';
    END IF;

    -- Runtime role must exist.
    IF NOT EXISTS (
        SELECT 1
        FROM pg_roles
        WHERE rolname = runtime_role
    ) THEN
        RAISE EXCEPTION
            'Application runtime database role does not exist: %',
            runtime_role;
    END IF;

    -- Runtime role must not be privileged.
    IF EXISTS (
        SELECT 1
        FROM pg_roles
        WHERE rolname = runtime_role
          AND (
              rolsuper
              OR rolcreaterole
          )
    ) THEN
        RAISE EXCEPTION
            'Runtime role must not be superuser or CREATEROLE';
    END IF;

    -- Find the actual audit table owner.
    SELECT pg_get_userbyid(c.relowner)
    INTO table_owner
    FROM pg_class c
    JOIN pg_namespace n
      ON n.oid = c.relnamespace
    WHERE n.nspname = 'public'
      AND c.relname = 'payout_reconciliation_audit'
      AND c.relkind IN ('r', 'p');

    IF table_owner IS NULL THEN
        RAISE EXCEPTION
            'Payout reconciliation audit table not found';
    END IF;

    -- Runtime must not own the audit table.
    IF runtime_role = table_owner THEN
        RAISE EXCEPTION
            'Runtime role must not own the audit table';
    END IF;

    -- Reject direct or indirect owner-role membership,
    -- including non-inherited memberships that could
    -- potentially allow SET ROLE.
    IF pg_has_role(
        runtime_role,
        table_owner,
        'MEMBER'
    ) THEN
        RAISE EXCEPTION
            'Runtime role must not be a member of the table-owner role';
    END IF;

    RAISE NOTICE
        'Audit hardening preconditions passed. Runtime: %, Owner: %',
        runtime_role,
        table_owner;

END;
$$;

-- ============================================================
-- 2. REMOVE UNNECESSARY PRIVILEGES
-- ============================================================

-- Prevent privileges from being granted to every role.
REVOKE ALL PRIVILEGES
ON TABLE public.payout_reconciliation_audit
FROM PUBLIC;

-- Remove explicit privileges from the runtime role.
REVOKE ALL PRIVILEGES
ON TABLE public.payout_reconciliation_audit
FROM :"runtime_role";

-- ============================================================
-- 3. GRANT MINIMUM REQUIRED PRIVILEGES
-- ============================================================

-- Application can read audit records and append new ones.
-- It must not modify or remove existing records.
GRANT SELECT, INSERT
ON TABLE public.payout_reconciliation_audit
TO :"runtime_role";

-- ============================================================
-- 4. VERIFY EFFECTIVE PRIVILEGES
-- ============================================================

DO $$
DECLARE
    runtime_role TEXT :=
        current_setting('neos.audit.runtime_role');
BEGIN

    -- No table-level UPDATE.
    IF has_table_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'UPDATE'
    )

    -- No column-level UPDATE on any column.
    OR has_any_column_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'UPDATE'
    )

    -- No DELETE.
    OR has_table_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'DELETE'
    )

    -- No TRUNCATE.
    OR has_table_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'TRUNCATE'
    )

    THEN
        RAISE EXCEPTION
            'Runtime role still has audit mutation privileges';
    END IF;

    -- SELECT must be available.
    IF NOT has_table_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'SELECT'
    ) THEN
        RAISE EXCEPTION
            'Runtime role missing SELECT privilege';
    END IF;

    -- INSERT must be available.
    IF NOT has_table_privilege(
        runtime_role,
        'public.payout_reconciliation_audit',
        'INSERT'
    ) THEN
        RAISE EXCEPTION
            'Runtime role missing INSERT privilege';
    END IF;

    RAISE NOTICE
        'Payout audit privileges verified successfully';

END;
$$;

-- ============================================================
-- 5. COMMIT
-- ============================================================

COMMIT;

\echo 'Payout reconciliation audit hardening completed'
