{
  "name": "neos-mobile",
  "version": "1.0.0",
  "description": "NEOS personal onboarding and identity verification",
  "main": "index.ts",
  "scripts": {
    "test": "tsx --test tests/journey.test.ts tests/config.test.ts tests/mocks.test.ts tests/money.test.ts tests/apiClient.test.ts tests/profileMapping.test.ts tests/logout.test.ts tests/credentialQueue.test.ts tests/wallets.test.ts tests/verifiedScreens.test.ts tests/amountInput.test.ts tests/transferEngine.test.ts tests/historyPaging.test.ts tests/displayName.test.ts tests/appLock.test.ts tests/sumsub.test.ts tests/kycFlow.test.ts tests/receipts.test.ts tests/notifications.test.ts tests/displayParts.test.ts tests/fx.test.ts tests/topUp.test.ts",
    "start": "expo start --localhost --port 8082",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/android.ps1",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx src tests app.config.ts",
    "format": "prettier --write App.tsx src tests app.config.ts",
    "format:check": "prettier --check App.tsx src tests app.config.ts",
    "check:release-bundle": "node scripts/check-release-bundle.mjs",
    "check:release-readiness": "tsx scripts/release-readiness.ts",
    "postinstall": "patch-package"
  },
  "type": "commonjs",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sumsub/react-native-mobilesdk-module": "1.46.1",
    "expo": "^55.0.31",
    "expo-auth-session": "~55.0.19",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-local-authentication": "~55.0.18",
    "expo-print": "~55.0.19",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "private": true
}
