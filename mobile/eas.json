{
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_MOCK_FEATURES": "all",
        "EXPO_PUBLIC_API_URL": "http://localhost:8080",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "http://localhost:8081/realms/neos",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "neos-mobile",
        "EXPO_PUBLIC_REDIRECT_URI": "neos://auth",
        "EXPO_PUBLIC_TERMS_VERSION": "1.0",
        "EXPO_PUBLIC_DEMO_KYC_RESULT": "APPROVED"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_MOCK_FEATURES": "none",
        "EXPO_PUBLIC_API_URL": "https://REPLACE_ME-staging-api.neos.example",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "https://REPLACE_ME-staging-auth.neos.example/realms/neos",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "neos-mobile",
        "EXPO_PUBLIC_REDIRECT_URI": "neos://auth",
        "EXPO_PUBLIC_TERMS_VERSION": "1.0",
        "EXPO_PUBLIC_TERMS_URL": "https://REPLACE_ME-staging.neos.example/terms"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_MOCK_FEATURES": "none",
        "EXPO_PUBLIC_API_URL": "https://REPLACE_ME-production-api.neos.example",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "https://REPLACE_ME-production-auth.neos.example/realms/neos",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "neos-mobile",
        "EXPO_PUBLIC_REDIRECT_URI": "neos://auth",
        "EXPO_PUBLIC_TERMS_VERSION": "1.0",
        "EXPO_PUBLIC_TERMS_URL": "https://REPLACE_ME-production.neos.example/terms"
      }
    }
  }
}
