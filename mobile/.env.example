# Which features are faked (dev builds only; see src/mockFeatures.ts and src/mocks/registry.ts):
#   all  -> every feature mocked
#   none -> nothing mocked (real backend everywhere; unavailable features show "not available yet")
#   or a comma-separated list: auth,onboarding,kyc,kycCapture,wallets,notifications
# Unset means none. Staging/production builds ALWAYS ignore this and run with zero mocks.
# If "auth" is mocked, onboarding,kyc,kycCapture,wallets,notifications must be mocked too (no real
# token). If "kyc" is mocked, "kycCapture" must be too (a real Sumsub session needs a real KYC start).
# kycCapture = the Sumsub SDK session (real: POST /api/kyc/sdk-token + the native SDK).
# Fully real run (Keycloak, backend and the Sumsub SDK): EXPO_PUBLIC_MOCK_FEATURES=none
# Example: everything real except a simulated Sumsub session and notifications:
#   EXPO_PUBLIC_MOCK_FEATURES=kycCapture,notifications
EXPO_PUBLIC_MOCK_FEATURES=none
# development | staging | demo | production. Anything but production (or unset) shows the
# permanent "Sandbox" badge on Home. Dev builds default to development.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/neos
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=neos-mobile
EXPO_PUBLIC_REDIRECT_URI=neos://auth
EXPO_PUBLIC_TERMS_VERSION=1.0
# Set to an approved, hosted terms page for real onboarding.
EXPO_PUBLIC_TERMS_URL=
# Only used when "kyc" is mocked: APPROVED, PENDING, REJECTED, MORE_INFO_REQUIRED
# (MORE_INFO_REQUIRED is the app's name for the backend's RESUBMISSION_REQUIRED)
EXPO_PUBLIC_DEMO_KYC_RESULT=APPROVED
